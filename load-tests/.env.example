# CrowdPay Load Testing Environment Variables
# Copy to .env or pass values using k6 environment flags (-e VAR=VALUE)
# Example usage:
#   k6 run -e BASE_URL=http://localhost:3001 load-tests/smoke.js

# Backend API target URL
BASE_URL=http://localhost:3001

# User credentials for authentication tests
CREATOR_EMAIL=bola@example.com
CREATOR_PASSWORD=creator123
CONTRIBUTOR_EMAIL=alice@example.com
CONTRIBUTOR_PASSWORD=password123
USER_EMAIL=test@example.com
USER_PASSWORD=password123

# Campaign IDs for test target requests
CAMPAIGN_ID=11111111-1111-1111-1111-111111111111
CAMPAIGN_IDS=11111111-1111-1111-1111-111111111111,22222222-2222-2222-2222-2222-222222222222
